# Salin ke .env.local lalu isi dari Supabase Dashboard -> Project Settings -> API.
# JANGAN commit .env.local. Jangan beri awalan NEXT_PUBLIC_ pada secret.

# URL project Supabase (publik)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) - aman untuk browser, dibatasi RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - HANYA server. Dipakai untuk membuat booking, cek booking, dan rate limit.
SUPABASE_SECRET_KEY=
# URL situs (untuk Open Graph / sitemap). Contoh: https://kribogadget.vercel.app
NEXT_PUBLIC_SITE_URL=
